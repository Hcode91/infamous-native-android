# Turns a SPIR-V binary into a C header: `static const uint32_t <NAME>[] = {...};`
file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" len)
set(words "")
set(i 0)
while(i LESS len)
    string(SUBSTRING "${hex}" ${i} 8 w)   # bytes b0 b1 b2 b3 of a little-endian word
    string(SUBSTRING "${w}" 0 2 b0)
    string(SUBSTRING "${w}" 2 2 b1)
    string(SUBSTRING "${w}" 4 2 b2)
    string(SUBSTRING "${w}" 6 2 b3)
    string(APPEND words "0x${b3}${b2}${b1}${b0},")
    math(EXPR i "${i} + 8")
    math(EXPR col "(${i} / 8) % 8")
    if(col EQUAL 0)
        string(APPEND words "\n")
    endif()
endwhile()
file(WRITE "${OUT}" "#pragma once\n#include <cstdint>\nstatic const uint32_t ${NAME}[] = {\n${words}\n};\n")
